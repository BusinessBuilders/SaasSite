# Atlas voice demo — the ONLY variables this file documents.
#
# It is named `.env.atlas.example`, not `.env.example`, on purpose: a file
# called `.env.example` promises a full example of every variable the site
# needs, and this is not that. The rest of the site's non-secret defaults live
# in `.env` / `.env.production`, and the Clerk/Stripe/database secrets are
# declared (and validated) in `src/libs/Env.ts`.
#
# Copy the keys you need into `.env.local` for local work, or
# `.env.production.local` on the VPS. Values are intentionally empty here: this
# file documents which keys exist, never their contents. `.env*.local` is
# gitignored and must never be committed.

# LiveKit media server the visitor's browser connects to, e.g. wss://<host>/<path>.
# Server-side only. All three below must be set together — when any is missing,
# POST /api/atlas/session answers 503 {"reason":"voice_not_configured"} and
# GET /api/atlas/health answers 503. The rest of the site is unaffected.
LIVEKIT_URL=

# LiveKit API key and secret used to sign the visitor's access token and to
# reach the server API from /api/atlas/health. Never expose these to the browser.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# How many voice sessions ONE visitor IP may start per rolling hour.
# Server-side only, optional — leave empty and the limiter allows 3. Must be a
# whole number, 1 or more: anything else (0, 2.5, "three") is a startup error
# naming this variable, never a silent fall back to the default.
ATLAS_SESSION_LIMIT_PER_HOUR=

# Monthly price shown on the Atlas voice page, digits only, e.g. 497.
# Public (compiled into the browser bundle). Leave empty and the page renders
# without a price rather than inventing one.
NEXT_PUBLIC_ATLAS_PRICE_MONTHLY=
